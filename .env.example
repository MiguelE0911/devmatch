# Copia este archivo a ".env" y completa tus propios valores.
# .env NUNCA se sube al repositorio (ver .gitignore).
#
# -----------------------------------------------------------------------------
# OBLIGATORIAS (las 3) - sin esto la app no arranca
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=tu-clave-generada-aqui
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/db?sslmode=require&channel_binding=require

# Genera la clave real con (produce ~67 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# La clave de ejemplo de arriba es publica y no sirve para nada: solo para que
# el archivo se pueda leer. En produccion, config/settings/prod.py RECHAZA
# arrancar si DJANGO_SECRET_KEY sigue siendo el valor de desarrollo.

# -----------------------------------------------------------------------------
# OPCIONALES - Neon Object Storage (subida de imagenes al bucket del equipo).
# Si estan COMPLETAS, las imagenes subidas van al bucket "public_read" y las
# ve todo el equipo. Si faltan (o estan vacias), la app funciona igual pero
# guarda en media/ local: solo tu maquina ve esas imagenes (fallback).
# Pide el endpoint y la credencial (scopes storage:read+write) al Integrador;
# la secret se muestra UNA sola vez al crearla. Nunca subas .env al repo.
# -----------------------------------------------------------------------------
#AWS_ACCESS_KEY_ID=nak_live_TU_TOKEN_ID_AQUI
#AWS_SECRET_ACCESS_KEY=nsk_live_TU_SECRET_KEY_AQUI
#AWS_ENDPOINT_URL_S3=https://TU_BRANCH_ID.storage.c-2.us-east-2.aws.neon.tech
#AWS_REGION=us-east-2
#NEON_STORAGE_BUCKET=devmatch-media

# -----------------------------------------------------------------------------
# OPCIONALES - solo para produccion. Todas tienen default seguro, asi que si
# no las defines la app arranca igual. Comentalas y descomentalas segun el
# despliegue. Ver config/settings/prod.py para el detalle de cada una.
# -----------------------------------------------------------------------------

# Redirigir HTTP a HTTPS (default: 1/true).
# Ponlo en 0 solo si hay unterminador TLS delante que ya lo haga.
#DJANGO_SECURE_SSL_REDIRECT=1

# Durata de HSTS en segundos (default: 3600).
# OJO: es pegajoso. Un navegador que lo ve lo aplica a TODOS los subdominios
# y no se puede revertir durante ese periodo.
#DJANGO_SECURE_HSTS_SECONDS=3600

# Aplicar HSTS tambien a los subdominios (default: 0/false).
# Activalo solo cuando TODOS los subdominios sirvan HTTPS. Si uno no lo hace,
# los usuarios quedan bloqueados y no hay como arreglarlo.
#DJANGO_HSTS_INCLUDE_SUBDOMAINS=0

# Enviar HSTS a la lista de preload de los navegadores (default: 0/false).
# Exige DJANGO_SECURE_HSTS_SECONDS >= 31536000 (1 ano); con menos, prod.py
# rechaza arrancar porque los navegadores no aceptan el preload por debajo de
# ese minimo.
#DJANGO_HSTS_PRELOAD=0

# Respetar la cabecera X-Forwarded-Proto (default: 0/false).
# Activala SOLO si hay un proxy/balanceador delante que termine TLS y la envie.
# Sin proxy real, marcarla con 1 permitiria falsificar la deteccion de HTTPS
# desde el cliente. Sin esto y con DJANGO_SECURE_SSL_REDIRECT=1, las paginas
# entran en un bucle de redireccion.
#DJANGO_USE_X_FORWARDED_PROTO=0

# Origenes extra de confianza para CSRF, separados por coma (default: vacio).
# Rellenalo solo si el formulario se sirve desde un dominio distinto.
#DJANGO_CSRF_TRUSTED_ORIGINS=https://app.ejemplo.com